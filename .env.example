# Vercel: public base URL of the Render API, with no trailing slash.
VITE_API_BASE_URL=https://your-render-service.onrender.com

# Render: exact Vercel frontend origin. Comma-separate additional production origins if needed.
FRONTEND_ORIGIN=https://your-vercel-project.vercel.app

# Render supplies PORT automatically. 8787 is only the local fallback.
PORT=8787
